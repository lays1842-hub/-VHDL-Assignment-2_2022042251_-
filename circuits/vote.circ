  <vhdl appearance="logisim_evolution" name="mux8_1">
library ieee;
use ieee.std_logic_1164.all;

entity mux8_1 is
    port (
        a, b, c, d, e, f, g, h : in std_logic;
        ch                   : in std_logic_vector(2 downto 0);
        data_out             : out std_logic
    );
end entity mux8_1;

architecture bhv of mux8_1 is
begin
    process(a, b, c, d, e, f, g, h, ch)
    begin
        case ch is
            when "000" =&gt; data_out &lt;= a;
            when "001" =&gt; data_out &lt;= b;
            when "010" =&gt; data_out &lt;= c;
            when "011" =&gt; data_out &lt;= d;
            when "100" =&gt; data_out &lt;= e;
            when "101" =&gt; data_out &lt;= f;
            when "110" =&gt; data_out &lt;= g;
            when "111" =&gt; data_out &lt;= h;
            when others =&gt; data_out &lt;= '0';
        end case;
    end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="seg7_letters">
library ieee;
use ieee.std_logic_1164.all;

entity seg7_letters is
    port (
        ch       : in  std_logic_vector(2 downto 0);
        segments : out std_logic_vector(7 downto 0)
    );
end entity seg7_letters;

architecture bhv of seg7_letters is
begin
    process(ch)
    begin
        case ch is
            when "000" =&gt; segments &lt;= "11111010"; -- a
            when "001" =&gt; segments &lt;= "00111110"; -- b
            when "010" =&gt; segments &lt;= "00011010"; -- c
            when "011" =&gt; segments &lt;= "01111010"; -- d
            when "100" =&gt; segments &lt;= "10001110"; -- f
            when "101" =&gt; segments &lt;= "11110110"; -- g
            when others =&gt; segments &lt;= "00000000";
        end case;
    end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="vote25">
library ieee;
use ieee.std_logic_1164.all;

entity vote25 is
    port (
        vt     : in  std_logic_vector(24 downto 0);
        result : out std_logic
    );
end entity vote25;

architecture bhv of vote25 is
begin
    process(vt)
        variable vote_count : integer range 0 to 25;
    begin
        vote_count := 0;

        for i in vt'range loop
            if vt(i) = '1' then
                vote_count := vote_count + 1;
            end if;
        end loop;

        if vote_count &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture bhv;
</vhdl>
